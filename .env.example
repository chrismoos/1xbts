# Copy this file to .env and edit before running docker compose.
# .env is gitignored; .env.example is the committed template.

# PostgreSQL password for the 1xBTS dev database.
# The default is fine for a local dev environment not exposed to a network.
POSTGRES_PASSWORD=1xbts

# BSC gRPC address (radio-access management, streaming events, HLR, SMSC, PCF/PDSN).
# MANAGEMENT_GRPC_ADDRESS=host.docker.internal:17016

# MSC gRPC address (initiate_call, list_calls, send_sms).
# MSC_GRPC_ADDRESS=host.docker.internal:17017
